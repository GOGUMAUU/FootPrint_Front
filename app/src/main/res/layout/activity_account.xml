<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6DE"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/bg_notification_circle"
                android:src="@drawable/ic_relations_back"
                android:contentDescription="@string/activity_account_back_content_description" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/account_settings_title"
                android:textSize="26sp"
                android:textColor="#2F7D46" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_profile_card"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_password"
                android:textSize="19sp"
                android:textColor="#2F7D46"
                android:textStyle="bold" />
            <TextView
                style="@style/AuthLabel"
                android:text="@string/activity_account_current_password_text"
                android:labelFor="@id/currentPassword" />
            <EditText
                android:id="@+id/currentPassword"
                style="@style/AuthInput"
                android:hint="@string/activity_account_current_password_hint"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:saveEnabled="false" />
            <TextView
                style="@style/AuthLabel"
                android:text="@string/activity_account_new_password_text"
                android:labelFor="@id/newPassword" />
            <EditText
                android:id="@+id/newPassword"
                style="@style/AuthInput"
                android:hint="@string/activity_account_new_password_hint"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:saveEnabled="false" />
            <TextView
                style="@style/AuthLabel"
                android:text="@string/activity_account_confirm_password_text"
                android:labelFor="@id/confirmPassword" />
            <EditText
                android:id="@+id/confirmPassword"
                style="@style/AuthInput"
                android:hint="@string/activity_account_confirm_password_hint"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:saveEnabled="false" />
            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@drawable/bg_auth_input"
                android:textColor="#9A542B"
                android:textSize="13sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/changePassword"
                style="@style/ProfileAction"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/change_password"
                android:letterSpacing="0" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_profile_card"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_management_title"
                android:textSize="19sp"
                android:textColor="#2F7D46"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logout"
                style="@style/ProfileSecondary"
                android:layout_height="52dp"
                android:text="@string/activity_account_logout_text"
                android:letterSpacing="0" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteAccount"
                style="@style/ProfileSecondary"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/activity_account_delete_account_text"
                android:textColor="#A65540"
                android:letterSpacing="0"
                app:strokeColor="#E4BEA9" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
