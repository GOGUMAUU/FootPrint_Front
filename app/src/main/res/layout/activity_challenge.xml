<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF6DF"
    android:fitsSystemWindows="true">

    <!-- 상단 뒤로가기 + 제목 + 내 배지 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- 기존 홈 버튼을 뒤로가기 아이콘으로 변경 -->
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            app:tint="#287D46" />

        <!-- 화면 제목 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="도전과제"
            android:textColor="#287D46"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 내 배지 버튼 -->
        <TextView
            android:id="@+id/btnMyBadges"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:background="@drawable/bg_filter_normal"
            android:text="내 배지"
            android:textColor="#287D46"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- 검색창 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_filter_normal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="@null"
            app:tint="#8C744F" />

        <EditText
            android:id="@+id/etChallengeSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="어떤 도전과제를 찾으세요?"
            android:singleLine="true"
            android:inputType="text"
            android:textColor="#3D5037"
            android:textColorHint="#A38F71"
            android:textSize="14sp"
            android:importantForAutofill="no" />

    </LinearLayout>

    <!-- 목록 제목 + 현재 위치 안내 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <!-- 목록 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="도전과제 목록"
            android:textColor="#397C4A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 제목과 위치 안내 사이의 여백 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 현재 위치 아이콘 -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_location_pin"
            android:contentDescription="@null"
            app:tint="#65836A" />

        <!-- 현재 위치 상태 -->
        <TextView
            android:id="@+id/tvCurrentLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160dp"
            android:text="위치 확인 중..."
            android:textColor="#65836A"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 필터 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/btnFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_selected"
                    android:text="전체"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_normal"
                    android:text="기본"
                    android:textColor="#444444"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterMine"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_normal"
                    android:text="내 도전과제"
                    android:textColor="#444444"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterFollowing"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_normal"
                    android:text="팔로잉"
                    android:textColor="#444444"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 상세 필터 버튼 -->
        <TextView
            android:id="@+id/btnChallengeAdvancedFilter"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:background="@drawable/bg_filter_normal"
            android:text="☷ 필터"
            android:textColor="#287D46"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- 아래로 당겨서 새로고침 + 도전과제 목록 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAchievableChallenges"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 도전과제 만들기 버튼 -->
    <Button
        android:id="@+id/btnCreateChallenge"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#287D46"
        android:text="+ 내 도전과제 만들기"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</LinearLayout>
