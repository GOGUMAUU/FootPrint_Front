<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">
    <!-- 상단 제목과 홈 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/achievable_challenges_title"
            android:textColor="#222222"
            android:textSize="22sp"
            android:textStyle="bold" />
        <!-- 내 배지 화면 이동 버튼 -->
        <TextView
            android:id="@+id/btnMyBadges"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:background="@drawable/bg_filter_normal"
            android:text="@string/activity_challenge_btn_my_badges_text"
            android:textColor="#444444"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="@string/activity_challenge_btn_home_content_description"
            app:tint="#222222" />
    </LinearLayout>
    <!-- 현재 위치 -->
    <TextView
        android:id="@+id/tvCurrentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/activity_challenge_tv_current_location_text"
        android:textColor="#777777"
        android:textSize="13sp" />
    <!-- 목록 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:text="@string/challenge_list_title"
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold" />
    <!-- 카테고리 필터 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">
            <!-- 전체 -->
            <TextView
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_filter_selected"
                android:text="@string/activity_challenge_btn_filter_all_text"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
            <!-- 기본 도전과제 -->
            <TextView
                android:id="@+id/btnFilterDefault"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_filter_normal"
                android:text="@string/activity_challenge_btn_filter_default_text"
                android:textColor="#444444"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
            <!-- 내 도전과제 -->
            <TextView
                android:id="@+id/btnFilterMine"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_filter_normal"
                android:text="@string/activity_challenge_btn_filter_mine_text"
                android:textColor="#444444"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
            <!-- 팔로우 도전과제 -->
            <TextView
                android:id="@+id/btnFilterFollowing"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_filter_normal"
                android:text="@string/activity_challenge_btn_filter_following_text"
                android:textColor="#444444"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>
    <!-- 아래로 당겨서 새로고침 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- 도전과제 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAchievableChallenges"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
