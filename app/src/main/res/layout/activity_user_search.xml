<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="사용자 찾기" android:textStyle="bold" android:textSize="22sp" />
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="닉네임 또는 사용자 코드" />
    <Button android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="검색" />
    <TextView android:id="@+id/tvPolicy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="주변 사람을 자동 노출하지 않습니다. 검색/코드로 찾은 사용자만 프로필을 열고 팔로우할 수 있습니다." android:paddingTop="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerUsers" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
