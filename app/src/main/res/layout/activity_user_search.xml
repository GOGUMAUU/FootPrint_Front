<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF6DE"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/activity_user_search_text_view_text"
            android:textSize="26sp"
            android:textColor="#2F7D46" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/requests"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_notification_circle"
            android:src="@drawable/ic_notification_bell"
            android:contentDescription="@string/activity_user_search_requests_content_description" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_profile_code"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp">
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_basic_profile"
            app:civ_border_width="1dp"
            app:civ_border_color="#173E00"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/myCode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/activity_user_search_my_code_text"
            android:textColor="#2F7D46"
            android:textSize="18sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyCode"
            style="@style/ProfileAction"
            android:layout_width="wrap_content"
            android:text="@string/activity_user_search_copy_code_text" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:background="@drawable/bg_profile_card"
            android:paddingHorizontal="14dp"
            android:hint="@string/activity_user_search_et_search_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#76583D"
            android:textColorHint="#A99985"
            android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            style="@style/ProfileAction"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/activity_user_search_btn_search_text"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvPolicy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="#76583D"
        android:accessibilityLiveRegion="polite" />
    <androidx.recyclerview.widget.RecyclerView
        tools:listitem="@layout/item_friend_card"
        tools:itemCount="3"
        android:id="@+id/recyclerUsers"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMore"
        style="@style/ProfileSecondary"
        android:text="@string/activity_user_search_btn_more_text"
        android:visibility="gone" />
</LinearLayout>
