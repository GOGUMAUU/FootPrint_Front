<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fp_card_detail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="21dp"
        android:paddingTop="24dp"
        android:paddingEnd="21dp"
        android:paddingBottom="31dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_fp_avatar"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/mascot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jua"
            android:text="방명록을 지울까요?"
            android:textColor="#2F7A44"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/gowun_dodum"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="지운 방명록은 되돌릴 수 없어요."
            android:textColor="#5E4128"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmCancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_fp_btn_sky"
                android:fontFamily="@font/jua"
                android:minHeight="0dp"
                android:paddingBottom="4dp"
                android:stateListAnimator="@null"
                android:text="취소"
                android:textAllCaps="false"
                android:textColor="#143F58"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmDelete"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_fp_btn_peach"
                android:fontFamily="@font/jua"
                android:minHeight="0dp"
                android:paddingBottom="4dp"
                android:stateListAnimator="@null"
                android:text="삭제"
                android:textAllCaps="false"
                android:textColor="#6A2A16"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
