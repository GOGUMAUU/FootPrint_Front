<?xml version="1.0" encoding="utf-8"?>
<!-- 위치기반서비스 동의 팝업. 카드 위로 마스코트가 살짝 올라오는 형태 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_fp_card_detail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="21dp"
        android:paddingTop="48dp"
        android:paddingEnd="21dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jua"
            android:gravity="center"
            android:text="위치 정보를 사용해도 될까요?"
            android:textColor="#2F7A44"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/gowun_dodum"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="내 근처의 방명록을 보여 드리려면\n지금 있는 위치가 필요해요."
            android:textColor="#5E4128"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvConsentNearby"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_fp_consent_green"
            android:fontFamily="@font/gowun_dodum"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp"
            android:textColor="#2F5E35"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvConsentUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fp_consent_sky"
            android:fontFamily="@font/gowun_dodum"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp"
            android:textColor="#1F4F6B"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvConsentCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fp_consent_peach"
            android:fontFamily="@font/gowun_dodum"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp"
            android:textColor="#7A3E2A"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvConsentToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/gowun_dodum"
            android:padding="4dp"
            android:text="약관 전문 보기"
            android:textColor="#9A7B5A"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/svConsentContent"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_fp_content"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvConsentContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gowun_dodum"
                android:lineSpacingMultiplier="1.15"
                android:padding="14dp"
                android:textColor="#5E4128"
                android:textSize="13sp" />
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConsentAgree"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_fp_btn_green"
            android:fontFamily="@font/jua"
            android:minHeight="0dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="동의하고 시작하기"
            android:textAllCaps="false"
            android:textColor="#FFFDF4"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/btnConsentLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/jua"
            android:padding="6dp"
            android:text="나중에 할게요"
            android:textColor="#8A6A4A"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/bg_fp_avatar"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:src="@drawable/mascot" />
</FrameLayout>
