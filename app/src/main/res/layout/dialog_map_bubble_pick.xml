<?xml version="1.0" encoding="utf-8"?>
<!-- 마이페이지 > 지도 말풍선에 보일 글 선택 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fp_card_detail"
        android:orientation="vertical"
        android:paddingStart="21dp"
        android:paddingTop="24dp"
        android:paddingEnd="21dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/jua"
            android:text="지도 말풍선에 보일 글"
            android:textColor="#2F7A44"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/gowun_dodum"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="여러 방명록이 한 자리에 모여 있을 때\n말풍선에 어떤 글을 보여 줄지 골라요."
            android:textColor="#5E4128"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/optRecommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_fp_pick_normal"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jua"
                android:text="추천"
                android:textColor="#2F5E35"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/gowun_dodum"
                android:text="열 수 있는 글 → 친구 글 → 인기 글 순으로 골라요"
                android:textColor="#80684C"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optPopular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fp_pick_normal"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jua"
                android:text="인기 글"
                android:textColor="#2F5E35"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/gowun_dodum"
                android:text="좋아요가 가장 많은 글"
                android:textColor="#80684C"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optLatest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fp_pick_normal"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jua"
                android:text="최신 글"
                android:textColor="#2F5E35"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/gowun_dodum"
                android:text="가장 최근에 남긴 글"
                android:textColor="#80684C"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPickClose"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_fp_btn_sky"
            android:fontFamily="@font/jua"
            android:minHeight="0dp"
            android:paddingBottom="4dp"
            android:stateListAnimator="@null"
            android:text="닫기"
            android:textAllCaps="false"
            android:textColor="#143F58"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
