<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_bar"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="28dp">
    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_container" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_map_filter_text_view_text"
        android:textColor="#5C432D"
        android:textSize="19sp"
        android:textStyle="bold" />
    <!-- 기간 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/dialog_map_filter_text_view_text_3"
        android:textColor="#5C432D"
        android:textSize="14sp"
        android:textStyle="bold" />
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupPeriod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/chipPeriodAll"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/activity_challenge_btn_filter_all_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chipPeriod7d"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_map_filter_chip_period7d_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chipPeriod30d"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_map_filter_chip_period30d_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
    </com.google.android.material.chip.ChipGroup>
    <!-- 연령대 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_map_filter_text_view_text_4"
        android:textColor="#5C432D"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true"
        android:visibility="gone">
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAgeAll"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/activity_challenge_btn_filter_all_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAge10s"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_map_filter_chip_age10s_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAge20s"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_map_filter_chip_age20s_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAge30s"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_map_filter_chip_age30s_text"
            android:textColor="@color/selector_chip_text"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="999dp"
            app:chipStrokeColor="@color/selector_chip_stroke"
            app:chipStrokeWidth="1.5dp"/>
    </com.google.android.material.chip.ChipGroup>
    <!-- 팔로잉 지도 모드일 때만 노출할 섹션 -->
    <LinearLayout
        android:id="@+id/layoutFollowingFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_map_filter_text_view_text_5"
            android:textColor="#5C432D"
            android:textStyle="bold"
            android:textSize="14sp" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true" />
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnResetFilter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/dialog_map_filter_btn_reset_filter_text"
            android:textColor="#5C432D"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="999dp"
            app:strokeColor="#E6D5AC"
            app:strokeWidth="1.5dp"/>
        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/dialog_map_filter_btn_apply_filter_text"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#2E6F3E"
            app:cornerRadius="999dp"/>
    </LinearLayout>
</LinearLayout>
