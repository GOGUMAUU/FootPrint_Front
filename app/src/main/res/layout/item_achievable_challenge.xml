<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_marginBottom="6dp"
    android:background="#F2F2F2">

    <!-- 카드 기본 배경 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2F2F2" />

    <!-- 기존 성취도 진행 막대 -->
    <View
        android:id="@+id/viewProgress"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#9E9E9E" />

    <!-- 도전과제 정보 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 도전과제 제목 -->
            <TextView
                android:id="@+id/tvChallengeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="도전과제 제목"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 목표 지점까지 남은 거리 -->
            <TextView
                android:id="@+id/tvChallengeDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="목표까지 거리 계산 중..."
                android:textColor="#555555"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 달성한 사용자 수 -->
            <TextView
                android:id="@+id/tvChallengeCompletedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="0명이 달성했어요!"
                android:textColor="#287D46"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 기존 성취도 퍼센트 -->
        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="0%"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
