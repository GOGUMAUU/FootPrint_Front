<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/friendAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_basic_profile"
        app:civ_border_width="1dp"
        app:civ_border_color="#173E00"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:id="@+id/friendName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#76583D"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="@string/item_follow_request_preview_friend_name_text" />
        <TextView
            android:id="@+id/friendSubtitle"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#80684C"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="@string/item_follow_request_preview_friend_subtitle_text" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/friendActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="@string/item_follow_request_preview_text_view_text"
            android:textColor="#2F7D46" />
        <TextView
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="@string/item_follow_request_preview_text_view_text_2"
            android:textColor="#76583D" />
    </LinearLayout>
</LinearLayout>
