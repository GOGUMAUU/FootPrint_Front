<?xml version="1.0" encoding="utf-8"?>
<!-- 게시판: 클러스터에 묶인 방명록 목록 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_fp_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_fp_sheet_handle" />

    <TextView
        android:id="@+id/tvBoardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:fontFamily="@font/jua"
        android:maxLines="1"
        android:text="이 자리의 방명록"
        android:textColor="#2F7A44"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvBoardCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/gowun_dodum"
        android:textColor="#9A7B5A"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/boardSortBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="120dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvBoardState"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:fontFamily="@font/gowun_dodum"
            android:gravity="center"
            android:textColor="#9A7B5A"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
