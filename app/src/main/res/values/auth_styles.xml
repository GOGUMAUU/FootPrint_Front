<resources>
    <style name="AuthLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#76583D</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="AuthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_auth_input</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#76583D</item>
        <item name="android:textColorHint">#918979</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
